{
  "name": "iblokz-ide",
  "version": "1.0.0",
  "description": "in browser / electron app code editor",
  "source": "src/index.pug",
  "main": "electron/main.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "start": "parcel",
    "start:electron": "parcel & sleep 2 && electron .",
    "build": "parcel build --public-url /ide/",
    "lint": "biome lint ./src && eslint src",
    "lint:fix": "biome lint --write ./src && eslint src --fix",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "init:electron": "./bin/init.sh --electron",
    "build:native": "./bin/build.sh",
    "deploy:native": "./bin/deploy.sh"
  },
  "author": "Alex Milanov <alex@i4web.biz>",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "acorn": "^8.0.1",
    "code-prettify": "github:alex-milanov/code-prettify",
    "font-awesome": "4.7.0",
    "iblokz-data": "^1.6.0",
    "iblokz-snabbdom-helpers": "^2.0.0",
    "iblokz-state": "^1.1.0",
    "rxjs": "^7.8.2",
    "snabbdom": "^3.6.3",
    "snapsvg": "^0.5.1",
    "tern": "^0.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@parcel/transformer-pug": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "electron": "^33.4.11",
    "eslint": "^8.57.0",
    "parcel": "^2.16.4",
    "path-browserify": "^1.0.0",
    "process": "^0.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
