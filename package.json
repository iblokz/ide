{
  "name": "iblokz-ide",
  "version": "1.5.0",
  "description": "in browser / electron app code editor",
  "source": "src/index.pug",
  "main": "electron/main.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "assets": "./bin/assets.sh",
    "assets:sync": "./bin/assets.sh --sync-only",
    "icons": "./bin/icons.sh",
    "prestart": "pnpm run assets",
    "prebuild": "pnpm run assets",
    "start": "parcel --host 0.0.0.0 --port 1234",
    "start:https": "parcel serve --https --host 0.0.0.0 --port 1234",
    "start:electron": "./bin/start.sh --electron",
    "start:android": "./bin/start.sh --android",
    "build": "parcel build --public-url /ide/ && pnpm run assets:sync",
    "prebuild:cap": "pnpm run assets",
    "build:cap": "parcel build --public-url ./ && pnpm run assets:sync",
    "prebuild:electron": "pnpm run assets",
    "build:electron": "parcel build --public-url ./ && pnpm run assets:sync",
    "dist:electron": "pnpm run build:electron && electron-builder --linux AppImage --publish never",
    "lint": "biome lint ./src && eslint src",
    "lint:fix": "biome lint --write ./src && eslint src --fix",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "init:electron": "./bin/init.sh --electron",
    "init:android": "./bin/init.sh --android",
    "build:native": "./bin/build.sh",
    "deploy:native": "./bin/deploy.sh",
    "postversion": "git push && git push --tags"
  },
  "author": "Alex Milanov <alex@i4web.biz>",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@fontsource/fira-code": "^5.2.7",
    "acorn": "^8.0.1",
    "chokidar": "^3.6.0",
    "code-prettify": "github:alex-milanov/code-prettify",
    "font-awesome": "4.7.0",
    "iblokz-data": "^1.6.0",
    "iblokz-snabbdom-helpers": "^2.0.0",
    "iblokz-state": "^1.1.0",
    "rxjs": "^7.8.2",
    "snabbdom": "^3.6.3",
    "snapsvg": "^0.5.1",
    "tern": "^0.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@capacitor/cli": "^6.2.1",
    "@parcel/transformer-pug": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "parcel": "^2.16.4",
    "path-browserify": "^1.0.0",
    "process": "^0.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
